{
  "schemaVersion": 1,
  "id": "fawe",
  "version": "${version}",
  "name": "FAWE Fabric",
  "description": "FastAsyncWorldEdit for Fabric. Base platform scaffold.",
  "authors": [
    "IntellectualSites",
    "FAWE Fabric port contributors"
  ],
  "license": "GPL-3.0",
  "environment": "*",
